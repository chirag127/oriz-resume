---
import Base from '../layouts/Base.astro'
import OzToolShell from '@chirag127/oz-chrome/components/OzToolShell.astro'
import Builder from '../components/Builder.tsx'
---

<Base>
  <OzToolShell site="resume" title="Resume Builder" wordmarkHref="https://oriz.in">
    <a slot="nav" href="#builder">Builder</a>
    <a slot="nav" href="https://github.com/chirag127/oriz-resume">Source</a>
    <a slot="footer" href="https://github.com/chirag127/oriz-resume">GitHub</a>

    <section class="hero">
      <p class="hero__kicker">The career press · resume.oriz.in</p>
      <h1 class="hero__title display">Free ATS resume builder, <em>set in type.</em></h1>
      <p class="hero__lede">
        Fill the form, watch it typeset live, print straight to PDF. Four ATS-clean templates,
        localStorage autosave, JSON import/export. 100% in your browser — no upload, no signup.
        Optional AI polishes your bullets when you want it.
      </p>
      <div class="hero__cta">
        <a class="btn btn--accent" href="#builder">Start writing</a>
        <a class="btn btn--ghost" href="https://github.com/chirag127/oriz-resume">View source</a>
      </div>
      <div class="hero__rule"></div>
      <div class="hero__meta">
        <div><strong>0</strong> uploads · 0 signup</div>
        <div><strong>4</strong> ATS templates</div>
        <div><strong>PDF</strong> print-perfect</div>
      </div>
    </section>

    <section class="features" aria-label="Features">
      <div class="feature">
        <h3>Live typesetting</h3>
        <p>Every keystroke re-typesets the page. What you see is exactly what prints.</p>
      </div>
      <div class="feature">
        <h3>Job-match AI</h3>
        <p>Paste a job description for an instant keyword gap, plus optional AI bullet tailoring.</p>
      </div>
      <div class="feature">
        <h3>Private by design</h3>
        <p>No backend, no account. Autosaved to your browser — it never leaves the device.</p>
      </div>
    </section>

    <div id="builder">
      <Builder client:load />
    </div>
  </OzToolShell>
</Base>
