---
import '../styles/theme.css'
import '../styles/builder.css'

interface Props {
  title?: string
  description?: string
}
const SITE = 'https://resume.oriz.in'
const {
  title = 'oriz Resume — free ATS resume builder, no signup',
  description = 'Free online ATS-friendly resume builder — fill a form, pick a template, live preview, and print to PDF. 100% in your browser, no upload, no signup.',
} = Astro.props
const canonical = new URL(Astro.url.pathname, SITE).href
const ogImage = new URL('/screenshots/desktop.png', SITE).href
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'oriz Resume',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  url: SITE,
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: [
    'ATS-clean templates',
    'Live typeset preview',
    'Print to PDF',
    'localStorage autosave',
    'JSON import/export',
    'Optional AI bullet rewriting',
  ],
  isAccessibleForFree: true,
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="theme-color" content="#14213d" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Resume" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="oriz Resume" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="800" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
    <script is:inline src="/registerSW.js"></script>
  </body>
</html>
