  },
  "dependencies": {
    "@astrojs/react": "^4.2.0",
    "@astrojs/sitemap": "^3.2.0",
    "@chirag127/oz-ai": "file:../design-system/packages/oz-ai",
    "@chirag127/oz-chrome": "file:../design-system/packages/oz-chrome",
    "@chirag127/oz-file": "file:../design-system/packages/oz-file",
    "@chirag127/oz-tokens-base": "file:../design-system/packages/oz-tokens-base",
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^6.4.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "vitest": "^3.2.4",
    "wrangler": "^4.107.0"
