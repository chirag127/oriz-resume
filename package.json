{
  "name": "oriz-resume",
  "version": "0.1.0",
  "description": "Astro source for resume.oriz.in — client-side ATS-clean resume builder: form → templates, live preview, print→PDF, localStorage autosave, JSON import/export",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
